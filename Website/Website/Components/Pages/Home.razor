@page "/"


<PageTitle>Home</PageTitle>

<h3>Upload CV</h3>
<button class="btn btn-primary">Upload CV</button>

<div>
    <h3>Uploaded CVs</h3>
    @foreach (var cv in uploadedCVs)
    {
        <p>@cv</p>
    }
</div>

@code {
    List<string> uploadedCVs = new List<string>();

    void HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var fileName = file.Name;
        uploadedCVs.Add(fileName);
    }
}
