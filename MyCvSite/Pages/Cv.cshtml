@page
@model MyCvSite.Pages.CvModel
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<div class="card shadow-sm p-4 mb-4">
	<table class="table">
		<thead>
			<tr>
				<th>CV</th>
				<th>Date</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach(var cv in Model.CVs)
			{
				<tr>
					<td>
						<a href="@cv.FileUrl" target="blank" title="Download">
							@cv.FileName
						</a>
					</td>
					<td>@cv.UploadDate</td>
					<td>
						<button type="button" class="btn" title="Options" data-bs-toggle="modal" data-bs-target="#cvActionsModal">
							<i class="bi bi-gear"></i>
						</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<div class="card shadow-sm mb-4 w-15 text-center">
	<form method="post" asp-page-handler="Create" enctype="multipart/form-data">
		<input type="file" id="cvFile" name="cv" class="form-control mb-3" />
		<button type="submit" class="btn" title="Upload"><i class="bi bi-cloud-upload fs-3"></i></button>
	</form>
</div>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show" role="alert">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}

<div class="modal fade" id="cvActionsModal" tabindex="-1" aria-labelledby="cvActionsModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body d-grid gap-3">
				<button type="button" class="btn btn-success">Get Feedback</button>
				<button type="button" class="btn btn-secondary">Edit</button>
				<button type="button" class="btn btn-danger">Delete</button>
			</div>
		</div>
	</div>
</div>
