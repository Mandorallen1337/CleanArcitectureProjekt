@page
@model MyCvSite.Pages.CvModel
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}
@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show" role="alert">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}

<div class="card shadow-sm p-4 mb-4">
	<table class="table">
		<thead>
			<tr>
				<th></th>
				<th></th>
				<th></th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach(var cv in Model.CVs)
			{
				<tr>
					<td>
						<a href="@cv.FileUrl" target="blank" title="Download">
							@cv.FileName
						</a>
					</td>
					<td>@cv.UploadDate</td>
					<td>
						<button type="submit" class="btn" title="Analyze"><i class="bi bi-robot fs-5"></i></button>
					</td>
					<td>
						<form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this CV?');">
							<input type="hidden" name="id" value="@cv.Id" />
							<button type="submit" class="btn" title="Delete">
								<i class="bi bi-trash fs-5"></i>
							</button>
						</form>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

<div class="card shadow-sm mb-4 w-15 text-center">
	<form method="post" asp-page-handler="Create" enctype="multipart/form-data">
		<input type="file" id="cvFile" name="cv" class="form-control mb-3" />
		<button type="submit" class="btn" title="Upload"><i class="bi bi-cloud-upload fs-3"></i></button>
	</form>
</div>
